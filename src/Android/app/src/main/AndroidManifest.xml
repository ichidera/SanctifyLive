<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access for WiFi and ADB-forwarded TCP -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Keep the screen on at all times — tablet is always-on at the pulpit -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SanctifyDisplay"
        android:hardwareAccelerated="true">

        <activity
            android:name=".DisplayActivity"
            android:exported="true"
            android:launchMode="singleInstance"

            <!-- Full-screen, immersive, hide nav bar, hide status bar -->
            android:windowSoftInputMode="stateAlwaysHidden"
            android:screenOrientation="landscape"

            <!-- Prevent config changes from restarting — keeps socket alive on rotate -->
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode"

            <!-- Keep screen on -->
            android:keepScreenOn="true"

            <!-- Exclude from recents so it's harder to accidentally swipe away -->
            android:excludeFromRecents="false"

            android:showWhenLocked="true"
            android:turnScreenOn="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
