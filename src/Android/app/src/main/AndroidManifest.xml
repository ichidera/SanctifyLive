<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access for WiFi and ADB-forwarded TCP -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Keep the screen on at all times — tablet is always-on at the pulpit -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SanctifyDisplay"
        android:hardwareAccelerated="true">

        <!--
          Full-screen, immersive, always-on stage display:
          - windowSoftInputMode: no on-screen keyboard should ever pop up
          - screenOrientation: landscape, matching how a stage display sits
          - configChanges: absorb rotation/size changes ourselves so the
            activity doesn't restart and drop the live TCP connection
          - keepScreenOn / showWhenLocked / turnScreenOn: this tablet is
            meant to sit at the pulpit permanently displaying content
        -->
        <activity
            android:name=".DisplayActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode"
            android:keepScreenOn="true"
            android:excludeFromRecents="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>