<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SanctifyLive Display"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Host IP -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Host IP"
        android:textSize="12sp"
        android:textColor="#888888" />

    <EditText
        android:id="@+id/etHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="127.0.0.1  (use this for USB/ADB)"
        android:inputType="text"
        android:singleLine="true"
        android:layout_marginBottom="12dp" />

    <!-- Port -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Port"
        android:textSize="12sp"
        android:textColor="#888888" />

    <EditText
        android:id="@+id/etPort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="55432"
        android:inputType="number"
        android:singleLine="true"
        android:layout_marginBottom="16dp" />

    <!-- Mode hint -->
    <TextView
        android:id="@+id/tvModeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="USB/ADB mode: run  adb forward tcp:55432 tcp:55432  on your PC, then use 127.0.0.1.\n\nWiFi mode: enter your PC's local IP address."
        android:textSize="11sp"
        android:textColor="#888888"
        android:layout_marginBottom="8dp" />

</LinearLayout>
